{
  "name": "necromancer",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "functions/*"],
  "packageManager": "bun@1.3.13",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev:app": "bun --cwd apps/app run dev",
    "dev:vessel": "bun --cwd apps/vessel run dev",
    "dev:studio": "bun --cwd apps/studio run dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "workflows:deploy": "sanity-workflows deploy",
    "schema:deploy:hq": "bun --cwd apps/studio run schema:deploy"
  },
  "devDependencies": {
    "@sanity/workflow-cli": "0.35.0",
    "@sanity/workflow-engine-test": "0.35.0",
    "@types/node": "^22",
    "typescript": "^5.9",
    "vitest": "^3.2"
  },
  "prettier": { "semi": false, "singleQuote": true, "printWidth": 100, "bracketSpacing": false }
}
