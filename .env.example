# ── Sanity ────────────────────────────────────────────────
SANITY_ORG_ID=oEouFCZpW
SANITY_PROJECT_ID=v9dl2xdi
SANITY_HQ_DATASET=hq
SANITY_SHOWCASE_DATASET=showcase
SANITY_API_VERSION=2026-09-01

# Server-only. NEVER prefix with SANITY_APP_ or NEXT_PUBLIC_.
SANITY_HQ_WRITE_TOKEN=          # project robot, editor on hq
SANITY_ORG_TOKEN=               # org robot: create datasets/projects, deploy schemas
SANITY_AUTH_TOKEN=              # CI only: org robot with "Manage SDK Apps" (app deploy) / workflows deploy

# ── AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NECRO_MODEL_REASONING=          # confirm current Claude Sonnet model id at build time
NECRO_MODEL_FAST=               # confirm current Claude Haiku model id at build time

# ── Worker ────────────────────────────────────────────────
DRAIN_SECRET=                   # Function kicker + Vessel drain route (server-only)
DRAIN_KICK=                     # optional App kick passphrase; Vessel accepts Bearer DRAIN_KICK too
VESSEL_URL=http://localhost:3000

# App bundle (non-secret). Vite exposes only SANITY_APP_*.
SANITY_APP_PROJECT_ID=v9dl2xdi
SANITY_APP_HQ_DATASET=hq
SANITY_APP_VESSEL_URL=http://localhost:3000
SANITY_APP_DRAIN_KICK=          # same value as DRAIN_KICK; never put DRAIN_SECRET / write tokens here
